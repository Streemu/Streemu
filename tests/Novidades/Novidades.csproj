<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Só o leitor das novidades (plano 027, etapa 1) e o log. Sem janela, sem rede, sem estado salvo. -->
    <Compile Include="../../app/Streemu/Util/Novidades.cs" Link="Novidades.cs" />
    <Compile Include="../../app/Streemu/Util/Log.cs" Link="Log.cs" />
    <!-- o mesmo recurso do exe, para provar que Embutidas() devolve o mesmo que a leitura do arquivo -->
    <EmbeddedResource Include="../../app/Streemu/NOVIDADES.md" LogicalName="Streemu.NOVIDADES.md" />
  </ItemGroup>
</Project>
