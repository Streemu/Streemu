<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <!-- Mesmo ciclo de vida e leitura de stderr do app; só janela, áudio e executável são simulados. -->
    <Compile Include="../../app/Streemu/Media/Viewer.cs" Link="Viewer.cs" />
    <Compile Include="../../app/Streemu/Media/Tools.cs" Link="Tools.cs" />
    <Compile Include="../../app/Streemu/Media/LiveSync.cs" Link="LiveSync.cs" />
    <!-- Só o núcleo da telemetria do caminho de mídia (sem o app): o teste confere os eventos de tentativa, falha e recuperação do player. -->
    <Compile Include="../../app/Streemu/Telemetria/CaminhoMidia.cs" Link="CaminhoMidia.cs" />
    <Compile Include="../../app/Streemu/Telemetria/CargaRecente.cs" Link="CargaRecente.cs" />
    <!-- Tools.cs limpa o stderr do ffmpeg/mpv com Higiene (caminho e convite) antes de logar. -->
    <Compile Include="../../app/Streemu/Telemetria/Higiene.cs" Link="Higiene.cs" />
  </ItemGroup>
</Project>
